rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedMember() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isParticipant(conversationId) {
      return verifiedMember()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantIds;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emailVerified == request.auth.token.email_verified;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emailVerified == request.auth.token.email_verified;

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /conversations/{conversationId} {
      allow create: if verifiedMember()
        && request.auth.uid in request.resource.data.participantIds;

      allow read, update: if verifiedMember()
        && request.auth.uid in resource.data.participantIds;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(conversationId);

        allow create: if isParticipant(conversationId)
          && request.resource.data.senderUid == request.auth.uid;

        allow update, delete: if isParticipant(conversationId)
          && resource.data.senderUid == request.auth.uid;
      }
    }

    match /sos_events/{eventId} {
      allow read: if verifiedMember();

      allow create: if verifiedMember()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if verifiedMember()
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
