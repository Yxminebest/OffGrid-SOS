@immutable
class AppPalette extends ThemeExtension<AppPalette> {
  const AppPalette({
    required this.background,
    required this.surface,
    required this.surfaceSoft,
    required this.border,
    required this.text,
    required this.muted,
    required this.info,
    required this.rescue,
    required this.success,
    required this.pending,
  });
  final Color background, surface, surfaceSoft, border, text, muted;
  final Color info, rescue, success, pending;

  static const light = AppPalette(
    background: Color(0x{{light.background}}),
    surface: Color(0x{{light.surface}}),
    surfaceSoft: Color(0x{{light.surface-soft}}),
    border: Color(0x{{light.border}}),
    text: Color(0x{{light.text}}),
    muted: Color(0x{{light.muted}}),
    info: Color(0x{{light.info}}),
    rescue: Color(0x{{light.rescue}}),
    success: Color(0x{{light.success}}),
    pending: Color(0x{{light.pending}}),
  );
  static const dark = AppPalette(
    background: Color(0x{{dark.background}}),
    surface: Color(0x{{dark.surface}}),
    surfaceSoft: Color(0x{{dark.surface-soft}}),
    border: Color(0x{{dark.border}}),
    text: Color(0x{{dark.text}}),
    muted: Color(0x{{dark.muted}}),
    info: Color(0x{{dark.info}}),
    rescue: Color(0x{{dark.rescue}}),
    success: Color(0x{{dark.success}}),
    pending: Color(0x{{dark.pending}}),
  );

  @override
  AppPalette copyWith({
    Color? background,
    Color? surface,
    Color? surfaceSoft,
    Color? border,
    Color? text,
    Color? muted,
    Color? info,
    Color? rescue,
    Color? success,
    Color? pending,
  }) => AppPalette(
    background: background ?? this.background,
    surface: surface ?? this.surface,
    surfaceSoft: surfaceSoft ?? this.surfaceSoft,
    border: border ?? this.border,
    text: text ?? this.text,
    muted: muted ?? this.muted,
    info: info ?? this.info,
    rescue: rescue ?? this.rescue,
    success: success ?? this.success,
    pending: pending ?? this.pending,
  );

  @override
  AppPalette lerp(covariant AppPalette? other, double t) {
    if (other == null) return this;
    return AppPalette(
      background: Color.lerp(background, other.background, t)!,
      surface: Color.lerp(surface, other.surface, t)!,
      surfaceSoft: Color.lerp(surfaceSoft, other.surfaceSoft, t)!,
      border: Color.lerp(border, other.border, t)!,
      text: Color.lerp(text, other.text, t)!,
      muted: Color.lerp(muted, other.muted, t)!,
      info: Color.lerp(info, other.info, t)!,
      rescue: Color.lerp(rescue, other.rescue, t)!,
      success: Color.lerp(success, other.success, t)!,
      pending: Color.lerp(pending, other.pending, t)!,
    );
  }
}

